# Speech-to-text provider: gemini | gcp | null
S2S_STT_PROVIDER=null

# --- Gemini ---
GEMINI_API_KEY=

# --- Google Cloud Speech-to-Text v2 ---
# Absolute path to the service-account JSON. Never commit the file itself.
# Local development only. The deployed (Cloud Run) configuration drops this
# variable entirely in favor of Application Default Credentials supplied by
# the attached runtime service account -- see docs/DEPLOY_SPEC.md DEPLOY-17.
# Do not set this in any deployed environment.
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=
GCP_SPEECH_LOCATION=global

# --- Justification polish (the single sanctioned model call) ---
ANTHROPIC_API_KEY=
S2S_POLISH_MODEL=

# Set to 1 to disable the polish node globally, equivalent to always passing --no-llm
S2S_NO_LLM=0

# Experimental, off by default. See docs/STT_SPEC.md section 6 before enabling.
S2S_EXPERIMENTAL_CLIP_ANALYSIS=0

# --- Server-side Firebase Auth (verifies the ID token the browser sends) ---
# The expected audience/issuer project when verifying a Firebase ID token
# server-side. Not secret -- a project id is public the same way the client
# config below is -- but it IS security-relevant: checking the token's
# audience against this value is what stops an ID token minted for a
# different Firebase project from being accepted here. See
# docs/DEPLOY_SPEC.md's Firebase Auth section (supersedes DEPLOY-9 through
# DEPLOY-14, the old shared-secret mechanism).
FIREBASE_PROJECT_ID=

# The only email domain allowed through the auth gate. This server-side
# check is authoritative. A client-side Google Sign-In `hd` (hosted domain)
# hint is UX only -- it can be bypassed client-side and must never be
# treated as enforcement on its own. See docs/DEPLOY_SPEC.md's Firebase Auth
# section and docs/WEB_SPEC.md for the client-side hint this backs up.
S2S_ALLOWED_EMAIL_DOMAIN=softical.tech

# --- Vite client config (compiled into the browser bundle at build time) ---
# Vite only exposes environment variables prefixed VITE_ to client code
# (see https://vitejs.dev/guide/env-and-mode.html#env-files); everything
# under this section ends up readable in the shipped JavaScript.
#
# THE MOST IMPORTANT COMMENT IN THIS FILE: the Firebase web API key below is
# NOT a secret. It is public client configuration by design -- Firebase's
# own docs describe it as identifying which Firebase project a request
# belongs to, not as an authorization credential. It will be compiled into
# the JS bundle and is visible to anyone who opens devtools or views page
# source. That is expected and fine.
#
# Do NOT put this key in Secret Manager -- that wastes effort protecting a
# value that ships to every browser regardless. And if you find it in a
# built bundle, that is not a leak and is not a reason to panic-rotate any
# credential: this key does not authorize anything by itself. Access control
# comes from Firebase Auth (the user must sign in) plus the server-side
# domain check above (S2S_ALLOWED_EMAIL_DOMAIN, verified against the ID
# token's claims), never from concealing this value.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Base URL the React app calls for the bridge API. Under the Firebase
# Hosting rewrite of /api/** to Cloud Run (docs/DEPLOY_SPEC.md), the app is
# served from the same origin as the API, so this is typically just "/api"
# -- a relative path, not a cross-origin host. Set to a full URL only for
# local development against `s2s serve` running on a different port.
VITE_API_BASE_URL=/api

# --- Deployment-only: app-level API key for the hosted bridge ---
# Deprecated. Superseded by Firebase Auth (see the Server-side Firebase Auth
# section above and docs/DEPLOY_SPEC.md's Firebase Auth section, which
# supersedes DEPLOY-9 through DEPLOY-14 in place per the CLAUDE.md
# deprecation rule -- nothing is deleted, only marked). Not used and not
# enforced by local `s2s serve` (loopback-only, no auth -- see
# docs/BRIDGE_SPEC.md). Left blank on purpose -- do not put a real key in
# this file, and do not add this secret to new deployments.
S2S_APP_API_KEY=
