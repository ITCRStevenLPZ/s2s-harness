.env
.venv/
__pycache__/
*.pyc
.s2s-cache/
runs/
*.wav
*.m4a
*.mp3
!tests/**/fixtures/*.wav
.pytest_cache/
.ruff_cache/
dist/

# Terraform (deploy/terraform) -- provider plugin cache and any local state/plan
# artifacts. The lock file (.terraform.lock.hcl) is intentionally NOT ignored; it is
# meant to be committed so provider version selection is reproducible.
deploy/terraform/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# graphify-out/cache/ is a content-addressed AST cache that regenerates
# (and partially churns) on every `graphify update .` -- every teammate
# runs that as part of their definition of done, so tracking it buries real
# diffs in cache noise on every commit. graph.json, GRAPH_REPORT.md and
# manifest.json (the actual index) stay tracked; only the cache is ignored.
# See team_findings.md [T4] for the discussion.
graphify-out/cache/
